# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=mplads
POSTGRES_PASSWORD=mplads_secure_password
POSTGRES_DB=mplads_sentinel
DATABASE_URL=postgresql+asyncpg://mplads:mplads_secure_password@localhost:5432/mplads_sentinel
SYNC_DATABASE_URL=postgresql://mplads:mplads_secure_password@localhost:5432/mplads_sentinel

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_PRIVATE_KEY_PATH=keys/jwtRS256.key
JWT_PUBLIC_KEY_PATH=keys/jwtRS256.key.pub
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
API_RATE_LIMIT=100
LOGIN_RATE_LIMIT=5

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
REFERENCE_DATE=2026-08-31
UPLOAD_DIR=uploads
REPORT_DIR=reports
